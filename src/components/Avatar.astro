---
import { getProfileDataAndIntroBlocks } from "../lib/services/notion/notionProfile";

// Props for controlling avatar size
const {
  width = 224, // default 224px
  height = 224, // default 224px
  class: className = "",
} = Astro.props;

// Get the Notion page ID from environment variable
const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;

let imageUrl: string | undefined = undefined;
let alt: string = "Profile image";
let isError = false;

try {
  const { profileData, images } = await getProfileDataAndIntroBlocks(pageId);
  if (images && images.length > 0) {
    imageUrl = images[0];
  }
  if (profileData?.name) {
    alt = profileData.name + " profile photo";
  }
} catch (error) {
  isError = true;
}
---

{
  isError ? (
    <div
      class={`rounded-sm bg-[var(--hover-bg)] dark:bg-gray-700 flex items-center justify-center text-[var(--border-color)] text-xs ${className}`}
      style={`width:${width}px;height:${height}px;`}
    >
      Error
    </div>
  ) : imageUrl ? (
    <img
      class={`rounded-sm object-cover ${className}`}
      src={imageUrl}
      alt={alt}
      width={width}
      height={height}
      style={`width:${width}px;height:${height}px;`}
      loading="eager"
    />
  ) : (
    <div
      class={`rounded-sm bg-[var(--hover-bg)] dark:bg-gray-700 flex items-center justify-center text-[var(--border-color)] text-xs ${className}`}
      style={`width:${width}px;height:${height}px;`}
    >
      N/A
    </div>
  )
}
