---
// Button.astro - Clean, minimal button component with animated border and optional icon support.

// ButtonProps defines the accepted properties for the Button component.
interface ButtonProps {
  text: string;
  icon?: any;
  iconPosition?: "left" | "right";
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  variant?: "spinButton" | "outlineButton";
  url?: string;
  target?: string;
  rel?: string;
  [key: string]: any;
}

// Destructure and provide default values for props.
const {
  text,
  icon: Icon,
  iconPosition = "left",
  type = "button",
  disabled = false,
  variant = "spinButton",
  url,
  target,
  rel,
  ...rest
} = Astro.props as ButtonProps;

// Determine if the link is external and set default target/rel for security.
const isExternal = url && /^https?:\/\//.test(url);
const linkTarget = target || (isExternal ? "_blank" : undefined);
const linkRel = rel || (isExternal ? "noopener noreferrer" : undefined);
---

// Render the button or anchor based on props and variant.
{
  variant === "spinButton" ? (
    <span class="relative inline-block overflow-hidden rounded-lg p-[1px]">
      {/* Animated border background */}
      <span class="absolute inset-[-1000%] pointer-events-none animate-[spin_2s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,#65A30D_0%,#A3E635_50%,#65A30D_100%)] dark:bg-[conic-gradient(from_90deg_at_50%_50%,#365314_0%,#86CC16_50%,#365314_100%)] rounded-lg" />
      {url ? (
        // Render as anchor if url is provided
        <a
          href={url}
          target={linkTarget}
          rel={linkRel}
          class="relative z-10 rounded-lg bg-transparent p-0 border-none focus:outline-none"
          aria-disabled={disabled}
          tabindex={disabled ? -1 : undefined}
          {...rest}
        >
          <div class="relative z-20 flex items-center justify-center px-5 py-3 text-base font-medium text-black dark:text-white bg-white/80 dark:bg-black/40 rounded-lg transition-colors duration-200">
            {/* Render icon on the left if provided */}
            {iconPosition === "left" && Icon && (
              <Icon class="w-4 h-4 me-2" aria-hidden="true" />
            )}
            <span>{text}</span>
            {/* Render icon on the right if provided */}
            {iconPosition === "right" && Icon && (
              <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
            )}
          </div>
        </a>
      ) : (
        // Render as button if no url is provided
        <button
          type={type}
          disabled={disabled}
          class="relative z-10 rounded-lg bg-transparent p-0 border-none focus:outline-none"
          {...rest}
        >
          <div class="relative z-20 flex items-center justify-center px-5 py-3 text-base font-medium text-black dark:text-white bg-white/80 dark:bg-black/40 rounded-lg transition-colors duration-200">
            {iconPosition === "left" && Icon && (
              <Icon class="w-4 h-4 me-2" aria-hidden="true" />
            )}
            <span>{text}</span>
            {iconPosition === "right" && Icon && (
              <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
            )}
          </div>
        </button>
      )}
    </span>
  ) : url ? (
    // OutlineButton variant rendered as anchor
    <a
      href={url}
      target={linkTarget}
      rel={linkRel}
      class="flex items-center justify-center px-5 py-3 text-base font-medium rounded-lg border-2 border-blue-700 dark:border-blue-400 bg-transparent text-blue-700 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors duration-200 focus:outline-none"
      aria-disabled={disabled}
      tabindex={disabled ? -1 : undefined}
      {...rest}
    >
      {iconPosition === "left" && Icon && (
        <Icon class="w-4 h-4 me-2" aria-hidden="true" />
      )}
      <span>{text}</span>
      {iconPosition === "right" && Icon && (
        <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
      )}
    </a>
  ) : (
    // OutlineButton variant rendered as button
    <button
      type={type}
      disabled={disabled}
      class="flex items-center justify-center px-5 py-3 text-base font-medium rounded-lg border-2 border-blue-700 dark:border-blue-400 bg-transparent text-blue-700 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20 transition-colors duration-200 focus:outline-none"
      {...rest}
    >
      {iconPosition === "left" && Icon && (
        <Icon class="w-4 h-4 me-2" aria-hidden="true" />
      )}
      <span>{text}</span>
      {iconPosition === "right" && Icon && (
        <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
      )}
    </button>
  )
}
