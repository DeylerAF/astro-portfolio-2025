---
import ThemeToggle from "./ThemeToggle.astro";
import SidebarToggle from "./sidebar/SidebarToggle.astro";
---

<!-- Flowbite-style responsive navbar with backdrop blur -->
<nav
  class="bg-[var(--header-bg)] bg-opacity-90 border-b border-[var(--border-color)] sticky top-0 z-30 w-full backdrop-blur-sm"
>
  <div class="flex flex-wrap items-center justify-between mx-auto p-3">
    <!-- Left: Brand and mobile sidebar toggle -->
    <div class="flex items-center gap-3">
      <!-- Sidebar toggle only visible on mobile -->
      <div class="md:hidden">
        <SidebarToggle isOpen={false} />
      </div>
      <a href="/" class="flex items-center gap-2">
        <span
          class="self-center text-xl font-semibold whitespace-nowrap text-[var(--text-color)]"
          >My Portfolio</span
        >
      </a>
    </div>
    <!-- Center: Navigation links (add more as needed) -->
    <!-- <div class="hidden w-full md:block md:w-auto">
      <ul
        class="flex flex-col md:flex-row md:space-x-8 md:mt-0 md:text-sm md:font-medium"
      >
        <li>
          <a
            href="/"
            class="block py-2 pl-3 pr-4 rounded md:bg-transparent md:p-0 text-[var(--text-color)] hover:text-[var(--accent-500)] focus:text-[var(--accent-500)] transition-colors"
            >Home</a
          >
        </li>
        <li>
          <a
            href="/products"
            class="block py-2 pl-3 pr-4 rounded md:bg-transparent md:p-0 text-[var(--text-color)] hover:text-[var(--accent-500)] focus:text-[var(--accent-500)] transition-colors"
            >Projects</a
          >
        </li>
      </ul>
    </div> -->
    <!-- Right: Theme toggle and slot -->
    <div class="flex items-center gap-2">
      <slot name="right" />
      <ThemeToggle />
    </div>
  </div>
</nav>

