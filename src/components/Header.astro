---
import ThemeToggle from "./ThemeToggle.astro";
import SidebarToggle from "./sidebar/SidebarToggle.astro";
---

<header
  id="main-header"
  class="fixed top-0 right-0 left-0 md:left-16 h-16 z-30 transition-all duration-300 ease-in-out border-b border-[var(--border-color)] flex items-center justify-between px-4 bg-[var(--header-bg)] backdrop-blur-sm bg-opacity-90"
>
  <div class="flex items-center gap-3">
    <!-- Sidebar toggle only visible on mobile -->
    <div class="md:hidden">
      <SidebarToggle isOpen={false} />
    </div>
    <h1 class="text-lg font-semibold">My Portfolio</h1>
  </div>
  <div class="flex items-center gap-2">
    <!-- Slot for additional content on the right -->
    <slot name="right" />
    <ThemeToggle />
  </div>
</header>

<script>
  // Script to synchronize the header position with sidebar state
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("main-header");
    const content = document.getElementById("content");

    if (!header || !content) return;

    // Header position classes
    const HEADER_POSITION = {
      sidebarExpanded: "md:left-64",
      sidebarCollapsed: "md:left-16",
    };

    // Update header position based on content class
    const updateHeaderPosition = () => {
      const isSidebarExpanded = content.classList.contains("md:ml-64");

      if (isSidebarExpanded) {
        header.classList.remove(HEADER_POSITION.sidebarCollapsed);
        header.classList.add(HEADER_POSITION.sidebarExpanded);
      } else {
        header.classList.remove(HEADER_POSITION.sidebarExpanded);
        header.classList.add(HEADER_POSITION.sidebarCollapsed);
      }
    };

    // Initialize with current state
    updateHeaderPosition();

    // Observe changes to content classes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === "class") {
          updateHeaderPosition();
        }
      });
    });

    // Start observing content element
    observer.observe(content, { attributes: true });
  });
</script>
