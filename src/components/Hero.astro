---
// Import necessary components
import type { PageObjectResponse } from "@notionhq/client/build/src/api-endpoints";
import { parseNotionProperties } from "../lib/services/notion";

// Define types for Notion blocks and responses
interface NotionRichText {
  plain_text: string;
  annotations?: Record<string, boolean>;
  href?: string | null;
  type: string;
  text?: { content: string; link: string | null };
}

interface NotionBlockContent {
  rich_text: NotionRichText[];
  color?: string;
  is_toggleable?: boolean;
}

interface NotionBlock {
  id: string;
  type: string;
  has_children: boolean;
  paragraph?: NotionBlockContent;
  heading_1?: NotionBlockContent;
  heading_2?: NotionBlockContent;
  heading_3?: NotionBlockContent;
  callout?: NotionBlockContent;
  [key: string]: any; // For other block types
}

// Default profile information in case Notion API is unavailable
const defaultProfile = {
  name: "Deyler Alvarez Fernández",
  experience: "+2 years of experience as",
  role: "Full-Stack Developer.",
  location: "From La Fortuna de San Carlos, Costa Rica 🇨🇷.",
  bio: "With a passion for turning innovative ideas into digital realities, I specialize in creating elegant, user-friendly web solutions that drive results. Let's collaborate and bring your digital vision to life.",
};

// Fetch and parse the Notion page with profile information
const profileId = "4be8c525e1394a76ab766b0e74e9f3db"; // The Notion page ID for your profile
let blocks: NotionBlock[] = [];

try {
  const response = await fetch(
    `https://api.notion.com/v1/blocks/${profileId}/children`,
    {
      headers: {
        Authorization: `Bearer ${import.meta.env.NOTION_API_KEY}`,
        "Notion-Version": "2022-06-28",
        "Content-Type": "application/json",
      },
    }
  );

  const data = await response.json();
  blocks = data.results || [];
} catch (error) {
  console.error("Error fetching Notion data:", error);
  // Continue with default values if API fails
}

// Helper function to safely extract text from blocks
function extractBlockText(blockType: string, contentPattern: string): string | null {
  try {
    if (!blocks || blocks.length === 0) return null;

    const block = blocks.find(
      (block) =>
        block.type === blockType &&
        block[blockType]?.rich_text?.[0]?.plain_text?.includes(contentPattern)
    );

    return block?.[blockType]?.rich_text?.[0]?.plain_text || null;
  } catch (error) {
    console.error(
      `Error extracting ${blockType} with pattern "${contentPattern}":`,
      error
    );
    return null;
  }
}

// Extract profile information with fallbacks
const name =
  extractBlockText("heading_1", "Deyler Alvarez Fernández")?.replace(
    "\n\n",
    ""
  ) || defaultProfile.name;
const experience =
  extractBlockText("paragraph", "+2 years of experience as") ||
  defaultProfile.experience;
const role =
  extractBlockText("paragraph", "Full-Stack Developer") || defaultProfile.role;
const location =
  extractBlockText("paragraph", "La Fortuna de San Carlos") ||
  defaultProfile.location;
const bio =
  extractBlockText("paragraph", "With a passion for") || defaultProfile.bio;
---

<div class="max-w-xl">
  <div class="flex items-end gap-4 mb-4">
    <img
      class="w-20 h-20 drop-shadow-[0px_0px_5px_rgba(0,0,0,0.5)] dark:drop-shadow-[0px_0px_5px_rgba(255,255,255,0.2)]"
      src="/images/hi.webp"
      alt="Hi"
      loading="eager"
      width="80"
      height="80"
    />
    <a
      href="https://www.linkedin.com/in/deyleraf/"
      target="_blank"
      rel="noopener"
      class="inline-block bg-[var(--accent-color)] hover:bg-[var(--accent-tertiary)] text-white px-3 py-1 rounded font-medium transition-colors"
    >
      Open to work
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-[var(--text-color)] sm:text-5xl"
  >
    {name.includes("Hi, I'm") ? name : `Hi, I'm ${name}`}
  </h1>
  <p
    class="flex flex-col gap-4 mt-6 text-xl text-[var(--text-color)] opacity-90"
  >
    <span>
      <span class="font-normal">{experience}</span>
      <strong class="text-[var(--accent-color)] font-semibold">{role}</strong>
    </span>
    <span>{location}</span>
    <span class="opacity-85">
