---
import { getProfileDataAndIntroBlocks } from "../lib/services/notion/notionProfile";
import type {
  ProcessedBlock,
  RichTextItem,
  ProfileData,
} from "../lib/types/notion";
import Badge from "./Badge.astro";

// Fetch profile data and intro blocks from Notion service
const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
const { profileData, introBlocks } = await getProfileDataAndIntroBlocks(pageId);

// Helper type guard for image block content
function isImageContent(
  content: unknown
): content is { url: string; caption?: string } {
  return (
    typeof content === "object" &&
    content !== null &&
    "url" in content &&
    typeof (content as any).url === "string"
  );
}

// Find the first image block to use as the profile image
const firstImageIdx = introBlocks.findIndex(
  (block) => block.type === "image" && isImageContent(block.content)
);
const profileImageBlock =
  firstImageIdx !== -1 ? introBlocks[firstImageIdx] : null;
---

<div class="max-w-xl">
  <div class="flex items-end gap-4 mb-4">
    {/* Render the first Notion image block as the avatar if available */}
    {
      profileImageBlock && isImageContent(profileImageBlock.content) && (
        <img
          src={profileImageBlock.content.url}
          alt={
            profileImageBlock.content.caption
              ? String(profileImageBlock.content.caption)
              : profileData?.name
                ? profileData.name + " profile photo"
                : "Profile image"
          }
          class="size-20 rounded-full object-cover drop-shadow-[0px_0px_5px_rgba(0,0,0,0.5)] dark:drop-shadow-[0px_0px_5px_rgba(255,255,255,0.2)]"
          width={80}
          height={80}
          loading="eager"
        />
      )
    }
    <a
      href="#"
      class="flex items-center transition md:justify-center md:hover:scale-105"
      tabindex="-1"
      aria-disabled="true"
    >
      <Badge>Open to work</Badge>
    </a>
  </div>
  {/* Render Notion heading_2 as the main h1 if available */}
  {
    (() => {
      const headingBlock = introBlocks.find(
        (block) => block.type === "heading_2"
      );
      if (headingBlock && Array.isArray(headingBlock.content)) {
        return (
          <h1 class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white">
            {(headingBlock.content as RichTextItem[]).map((text) => (
              <span
                class:list={{
                  "font-bold": text.annotations?.bold,
                  italic: text.annotations?.italic,
                  "text-lime-600 dark:text-lime-400": text.annotations?.bold,
                }}
              >
                {text.text}
              </span>
            ))}
          </h1>
        );
      }
      return null;
    })()
  }
  {
    /* Render all blocks except heading_2 and the first image block (used as avatar) */
  }
  <div
    class="flex flex-col gap-4 mt-6 text-xl text-gray-800 dark:text-gray-300"
  >
    {
      introBlocks.map((block, idx) => {
        if (block.type === "heading_2" || idx === firstImageIdx) return null;
        if (block.type === "paragraph") {
          return (
            <p class="[&>strong]:text-lime-600 dark:[&>strong]:text-lime-400 [&>strong]:font-semibold">
              {Array.isArray(block.content)
                ? (block.content as RichTextItem[]).map((text) => (
                    <span
                      class:list={{
                        "font-bold": text.annotations?.bold,
                        italic: text.annotations?.italic,
                        "text-lime-600 dark:text-lime-400":
                          text.annotations?.bold,
                      }}
                    >
                      {text.text}
                    </span>
                  ))
                : block.content}
            </p>
          );
        } else if (block.type === "heading_1") {
          return (
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white mt-6 mb-2">
              {Array.isArray(block.content)
                ? (block.content as RichTextItem[]).map((text) => (
                    <span
                      class:list={{
                        "font-bold": text.annotations?.bold,
                        italic: text.annotations?.italic,
                        "text-lime-600 dark:text-lime-400":
                          text.annotations?.bold,
                      }}
                    >
                      {text.text}
                    </span>
                  ))
                : block.content}
            </h1>
          );
        } else if (block.type === "heading_3") {
          return (
            <h3 class="text-lg font-medium text-gray-700 dark:text-gray-300 mt-2 mb-1">
              {Array.isArray(block.content)
                ? (block.content as RichTextItem[]).map((text) => (
                    <span
                      class:list={{
                        "font-bold": text.annotations?.bold,
                        italic: text.annotations?.italic,
                        "text-lime-600 dark:text-lime-400":
                          text.annotations?.bold,
                      }}
                    >
                      {text.text}
                    </span>
                  ))
                : block.content}
            </h3>
          );
        } else if (block.type === "image" && isImageContent(block.content)) {
          return (
            <figure class="my-6 w-full">
              <img
                src={block.content.url}
                alt={
                  block.content.caption
                    ? String(block.content.caption)
                    : "Profile image"
                }
                class="max-w-full h-auto rounded-lg mx-auto shadow"
              />
              {block.content.caption && (
                <figcaption class="text-center mt-2 text-sm text-gray-500 italic">
                  {String(block.content.caption)}
                </figcaption>
              )}
            </figure>
          );
        }
        return null;
      })
    }
  </div>
</div>
