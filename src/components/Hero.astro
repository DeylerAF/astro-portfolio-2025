---
import { getProfileDataAndIntroBlocks } from "../lib/services/notion/notionProfile";
import type { RichTextItem } from "../lib/types/notion";
import Avatar from "./Avatar.astro";
import { Linkedin, ShoppingCart } from "lucide-astro";
import Button from "./buttons/Button.astro";

// Fetch profile data, intro blocks, and all images from Notion service
const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
const { profileData, introBlocks, images } =
  await getProfileDataAndIntroBlocks(pageId);
---

<div
  class="grid grid-cols-1 grid-rows-[auto,auto,auto] gap-2 w-full
    md:grid-cols-5 md:grid-rows-5 md:gap-4"
>
  {/* Image section (Avatar + extra images) */}
  <div
    class="div1 col-span-1 row-span-1 order-1 flex flex-col items-center justify-center gap-2
      md:col-span-2 md:row-span-5 md:order-1 md:gap-8"
  >
    <div class="w-full h-full flex items-center justify-center">
      <Avatar
        width="100%"
        height="100%"
        class="w-full h-full max-w-xs max-h-xs md:max-w-[320px] md:max-h-[320px] object-cover"
      />
    </div>
    {/* Render all images except the first one (used as avatar) */}
    {
      images.length > 1 && (
        <div class="flex flex-col gap-2 md:gap-6 w-full">
          {images.slice(1).map((imgUrl, idx) => (
            <img
              src={imgUrl}
              alt={`Notion image ${idx + 2}`}
              class="max-w-full h-auto rounded-lg mx-auto shadow"
              loading="lazy"
            />
          ))}
        </div>
      )
    }
  </div>

  {/* Buttons section - order 2 on mobile, order 3 on desktop */}
  <div
    class="div3 col-span-1 row-span-1 order-2 flex items-center justify-center gap-2 mt-2
      md:col-span-3 md:col-start-3 md:row-span-1 md:row-start-5 md:items-end md:justify-start md:gap-4 md:mb-4 md:order-3"
  >
    <Button
      variant="outlineButton"
      text="Open to work"
      url="https://www.linkedin.com/in/deyleraf/"
      icon={Linkedin}
      iconPosition="left"
      type="button"
      class="m-0"
      aria-label="Go to LinkedIn profile"
      color="accent"
      responsiveSize={true}
      responsiveSizeConfig={{
        mobile: "small",
        tablet: "normal",
        desktop: "normal",
        largeDesktop: "large",
      }}
    />
    <Button
      variant="spinButton"
      text="View Products"
      url="/products"
      icon={ShoppingCart}
      iconPosition="left"
      type="button"
      class="m-0"
      aria-label="Go to products page"
      color="accent"
      responsiveSize={true}
      responsiveSizeConfig={{
        mobile: "small",
        tablet: "normal",
        desktop: "normal",
        largeDesktop: "large",
      }}
    />
  </div>

  {
    /* Text section (heading and intro blocks) - order 3 on mobile, order 2 on desktop */
  }
  <div
    class="div2 col-span-1 row-span-1 order-3 flex flex-col justify-start gap-2
      md:col-span-3 md:col-start-3 md:row-span-4 md:row-start-1 md:justify-end md:gap-4 md:order-2"
  >
    {/* Render Notion heading_2 as the main h1 if available */}
    {
      (() => {
        const headingBlock = introBlocks.find(
          (block) => block.type === "heading_2"
        );
        if (headingBlock && Array.isArray(headingBlock.content)) {
          return (
            <h1 class="text-3xl font-bold tracking-tight text-[var(--text-color)] sm:text-4xl md:text-5xl mb-2 md:mb-4">
              {(headingBlock.content as RichTextItem[]).map((text) => (
                <span
                  class:list={{
                    "font-bold": text.annotations?.bold,
                    italic: text.annotations?.italic,
                    "text-[var(--accent-500)]": text.annotations?.bold,
                  }}
                >
                  {text.text}
                </span>
              ))}
            </h1>
          );
        }
        return null;
      })()
    }
    {
      /* Render all blocks except heading_2 and the first image block (if it matches images[0]) */
    }
    <div
      class="flex flex-col gap-2 md:gap-4 text-base md:text-xl text-[var(--text-color)]"
    >
      {
        introBlocks.map((block) => {
          if (block.type === "heading_2") return null;
          // Skip the first image block if its url matches images[0]
          if (
            block.type === "image" &&
            typeof block.content === "object" &&
            block.content !== null &&
            "url" in block.content &&
            block.content.url === images[0]
          ) {
            return null;
          }
          if (block.type === "paragraph") {
            if (Array.isArray(block.content)) {
              return (
                <p class="[&>strong]:text-[var(--accent-500)] [&>strong]:font-semibold">
                  {(block.content as RichTextItem[]).map((text) => (
                    <span
                      class:list={{
                        "font-bold": text.annotations?.bold,
                        italic: text.annotations?.italic,
                        "text-[var(--accent-500)]": text.annotations?.bold,
                      }}
                    >
                      {text.text}
                    </span>
                  ))}
                </p>
              );
            } else if (typeof block.content === "string") {
              return (
                <p class="[&>strong]:text-[var(--accent-500)] [&>strong]:font-semibold">
                  {block.content}
                </p>
              );
            }
            return null;
          } else if (block.type === "heading_1") {
            return (
              <h1 class="text-2xl font-bold text-[var(--text-color)] mt-6 mb-2">
                {Array.isArray(block.content)
                  ? (block.content as RichTextItem[]).map((text) => (
                      <span
                        class:list={{
                          "font-bold": text.annotations?.bold,
                          italic: text.annotations?.italic,
                          "text-[var(--accent-500)]": text.annotations?.bold,
                        }}
                      >
                        {text.text}
                      </span>
                    ))
                  : block.content}
              </h1>
            );
          } else if (block.type === "heading_3") {
            return (
              <h3 class="text-lg font-medium text-[var(--sidebar-text)] dark:text-gray-300 mt-2 mb-1">
                {Array.isArray(block.content)
                  ? (block.content as RichTextItem[]).map((text) => (
                      <span
                        class:list={{
                          "font-bold": text.annotations?.bold,
                          italic: text.annotations?.italic,
                          "text-[var(--accent-500)]": text.annotations?.bold,
                        }}
                      >
                        {text.text}
                      </span>
                    ))
                  : block.content}
              </h3>
            );
          }
          // Do not render any image blocks (handled by firstImage)
          return null;
        })
      }
    </div>
  </div>
</div>
