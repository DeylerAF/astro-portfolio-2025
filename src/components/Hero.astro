---
import { getProfileDataAndIntroBlocks } from "../lib/services/notion/notionProfile";
import type { RichTextItem } from "../lib/types/notion";
import Badge from "./Badge.astro";
import Avatar from "./Avatar.astro";
import Button from "./Button.astro";
import { Mail } from "lucide-astro";

// Fetch profile data, intro blocks, and all images from Notion service
const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
const { profileData, introBlocks, images } =
  await getProfileDataAndIntroBlocks(pageId);
---

<div class="w-full">
  <div class="flex items-end gap-4 mb-4">
    <Avatar />
    <a
      href="#"
      class="flex items-center transition md:justify-center md:hover:scale-105"
      tabindex="-1"
      aria-disabled="true"
    >
      <Badge>Open to work</Badge>
    </a>
    <!-- Example usage of the Button component with icon, url, and other props -->
    <Button
      text="View Products"
      url="/products"
      icon={Mail}
      iconPosition="left"
      type="button"
      class="m-0"
      aria-label="Go to products page"
    />
  </div>
  {/* Render Notion heading_2 as the main h1 if available */}
  {
    (() => {
      const headingBlock = introBlocks.find(
        (block) => block.type === "heading_2"
      );
      if (headingBlock && Array.isArray(headingBlock.content)) {
        return (
          <h1 class="text-4xl font-bold tracking-tight text-[var(--text-color)] sm:text-5xl dark:text-white mb-4">
            {(headingBlock.content as RichTextItem[]).map((text) => (
              <span
                class:list={{
                  "font-bold": text.annotations?.bold,
                  italic: text.annotations?.italic,
                  "text-[var(--accent-color)]": text.annotations?.bold,
                }}
              >
                {text.text}
              </span>
            ))}
          </h1>
        );
      }
      return null;
    })()
  }
  {/* Render all images except the first one (used as avatar) */}
  {
    images.length > 1 && (
      <div class="flex flex-col gap-6 mt-6">
        {images.slice(1).map((imgUrl, idx) => (
          <img
            src={imgUrl}
            alt={`Notion image ${idx + 2}`}
            class="max-w-full h-auto rounded-lg mx-auto shadow"
            loading="lazy"
          />
        ))}
      </div>
    )
  }
  {
    /* Render all blocks except heading_2 and the first image block (if it matches images[0]) */
  }
  <div
    class="flex flex-col gap-4 mt-6 text-xl text-[var(--text-color)] dark:text-gray-300"
  >
    {
      introBlocks.map((block) => {
        if (block.type === "heading_2") return null;
        // Skip the first image block if its url matches images[0]
        if (
          block.type === "image" &&
          typeof block.content === "object" &&
          block.content !== null &&
          "url" in block.content &&
          block.content.url === images[0]
        ) {
          return null;
        }
        if (block.type === "paragraph") {
          if (Array.isArray(block.content)) {
            return (
              <p class="[&>strong]:text-[var(--accent-color)] [&>strong]:font-semibold">
                {(block.content as RichTextItem[]).map((text) => (
                  <span
                    class:list={{
                      "font-bold": text.annotations?.bold,
                      italic: text.annotations?.italic,
                      "text-[var(--accent-color)]": text.annotations?.bold,
                    }}
                  >
                    {text.text}
                  </span>
                ))}
              </p>
            );
          } else if (typeof block.content === "string") {
            return (
              <p class="[&>strong]:text-[var(--accent-color)] [&>strong]:font-semibold">
                {block.content}
              </p>
            );
          }
          return null;
        } else if (block.type === "heading_1") {
          return (
            <h1 class="text-2xl font-bold text-[var(--text-color)] dark:text-white mt-6 mb-2">
              {Array.isArray(block.content)
                ? (block.content as RichTextItem[]).map((text) => (
                    <span
                      class:list={{
                        "font-bold": text.annotations?.bold,
                        italic: text.annotations?.italic,
                        "text-[var(--accent-color)]": text.annotations?.bold,
                      }}
                    >
                      {text.text}
                    </span>
                  ))
                : block.content}
            </h1>
          );
        } else if (block.type === "heading_3") {
          return (
            <h3 class="text-lg font-medium text-[var(--sidebar-text)] dark:text-gray-300 mt-2 mb-1">
              {Array.isArray(block.content)
                ? (block.content as RichTextItem[]).map((text) => (
                    <span
                      class:list={{
                        "font-bold": text.annotations?.bold,
                        italic: text.annotations?.italic,
                        "text-[var(--accent-color)]": text.annotations?.bold,
                      }}
                    >
                      {text.text}
                    </span>
                  ))
                : block.content}
            </h3>
          );
        }
        // Do not render any image blocks (handled by firstImage)
        return null;
      })
    }
  </div>
</div>
