---
import {
  getPageById,
  getBlockChildren,
  parseNotionProperties,
  processBlocksForRendering,
  extractIcon,
} from "../lib/services/notion";
import type {
  BlockObjectResponse,
  PageObjectResponse,
} from "@notionhq/client/build/src/api-endpoints";
import type { ProcessedBlock, RichTextItem } from "../lib/types/notion";

// Define interface for our profile data
interface ProfileData {
  name: string;
  title: string;
  description: string;
  avatarUrl: string;
}

// Initialize state variables
let profileData: ProfileData | null = null;
let introBlocks: ProcessedBlock[] = [];
let isLoading = true;
let hasError = false;
let errorMessage = "";

/**
 * Extract profile data from Notion page
 */
const extractProfileData = (page: PageObjectResponse): ProfileData => {
  // Parse the properties using the existing utility
  const properties = parseNotionProperties(page.properties);

  // Initialize profile data with empty values
  const data: ProfileData = {
    name: "",
    title: "",
    description: "",
    avatarUrl: "",
  };
  // Extract name, title and description from parsed properties
  data.name = (properties.title as string) || (properties.Name as string) || "";
  data.title = (properties.Title as string) || "";
  data.description = (properties.Description as string) || "";

  // Extract avatar/profile image (icon or cover)
  const icon = extractIcon(page);
  if (icon) {
    data.avatarUrl = icon.value;
  } else if (page.cover?.type === "external" && page.cover.external.url) {
    data.avatarUrl = page.cover.external.url;
  }

  return data;
};

try {
  // Ensure we have the required environment variables
  if (!import.meta.env.PUBLIC_NOTION_TOKEN) {
    throw new Error("Missing PUBLIC_NOTION_TOKEN environment variable");
  }

  if (!import.meta.env.PUBLIC_NOTION_PAGE_ID) {
    throw new Error("Missing PUBLIC_NOTION_PAGE_ID environment variable");
  }

  // Use the provided page ID
  const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
  console.log("Fetching Notion page with ID:", pageId);

  // Fetch the page data
  const page = await getPageById(pageId);

  if (page) {
    // Extract the essential profile data
    profileData = extractProfileData(page);

    // Fetch the page blocks
    const blocksResponse = await getBlockChildren(pageId);

    if (blocksResponse && blocksResponse.results) {
      // Use the existing function to process blocks
      const allBlocks = blocksResponse.results.filter(
        (block): block is BlockObjectResponse =>
          typeof block === "object" && block !== null && "type" in block
      );

      // Process blocks for rendering
      const processedBlocks = processBlocksForRendering(allBlocks);

      // Get intro blocks (stop at first callout which is typically a section heading)
      for (const block of processedBlocks) {
        if (block.type === "callout") {
          break;
        }

        if (
          block.type === "paragraph" ||
          block.type.startsWith("heading_") ||
          block.type === "image"
        ) {
          introBlocks.push(block);
        }
      }
    }

    console.log("Successfully loaded profile data from Notion");
    console.log(`Loaded ${introBlocks.length} intro blocks`);
  } else {
    hasError = true;
    errorMessage = "Could not fetch page from Notion API";
    console.warn(errorMessage);
  }
} catch (error) {
  hasError = true;
  errorMessage =
    error instanceof Error
      ? error.message
      : "Unknown error fetching Notion data";
  console.error("Error fetching Notion data:", error);
} finally {
  isLoading = false;
}
---

<div class="profile-container">
  {
    hasError || !profileData ? (
      <div class="profile-error">
        <h2>Could not load profile data</h2>
        <p>{errorMessage}</p>
        <p>Check your Notion connection settings or try again later.</p>
        <button class="retry-button" onclick="window.location.reload()">
          Retry
        </button>
      </div>
    ) : (
      <>
        <div class="profile-header">
          {profileData.avatarUrl && profileData.avatarUrl.startsWith("http") ? (
            <img
              src={profileData.avatarUrl}
              alt={profileData.name}
              class="profile-avatar"
            />
          ) : profileData.avatarUrl ? (
            <div class="profile-avatar-emoji">{profileData.avatarUrl}</div>
          ) : (
            <div class="profile-avatar-emoji">👤</div>
          )}
          <div class="profile-title">
            <h1>{profileData.name}</h1>
            <h2>{profileData.title}</h2>
          </div>
        </div>

        {/* Display intro blocks from Notion */}
        <div class="profile-intro">
          {introBlocks.map((block) => {
            if (block.type === "paragraph") {
              return (
                <p class="profile-paragraph">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </p>
              );
            } else if (block.type === "heading_1") {
              return (
                <h1 class="profile-heading-1">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h1>
              );
            } else if (block.type === "heading_2") {
              return (
                <h2 class="profile-heading-2">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h2>
              );
            } else if (block.type === "heading_3") {
              return (
                <h3 class="profile-heading-3">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h3>
              );
            } else if (
              block.type === "image" &&
              typeof block.content === "object" &&
              block.content &&
              "url" in block.content
            ) {
              return (
                <figure class="profile-image-container">
                  <img
                    src={block.content.url as string}
                    alt={
                      block.content.caption
                        ? String(block.content.caption)
                        : "Profile image"
                    }
                    class="profile-image"
                  />
                  {block.content.caption && (
                    <figcaption class="profile-image-caption">
                      {String(block.content.caption)}
                    </figcaption>
                  )}
                </figure>
              );
            }
            return null;
          })}
        </div>
      </>
    )
  }
</div>

<style>
  .profile-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar-emoji {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .profile-title h1 {
    margin: 0;
    font-size: 1.8rem;
    color: var(--text-color, #333);
  }

  .profile-title h2 {
    margin: 0.5rem 0 0;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--secondary-text-color, #666);
  }

  .profile-description {
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .profile-error {
    text-align: center;
    padding: 2rem;
    background-color: #fff5f5;
    border-radius: 8px;
    color: #e53e3e;
  }

  .retry-button {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: #e53e3e;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .retry-button:hover {
    background-color: #c53030;
  }

  /* Estilos para imágenes */
  .profile-image-container {
    margin: 1.5rem 0;
    width: 100%;
  }

  .profile-image {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 0 auto;
  }

  .profile-image-caption {
    text-align: center;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--secondary-text-color, #666);
    font-style: italic;
  }

  /* Responsive adjustments */
  @media (width <= 600px) {
    .profile-header {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
