---
import { getPageById, getBlockChildren } from "../lib/services/notion";

// Define interfaces for our profile data types
interface ProfileData {
  name: string;
  title: string;
  description: string;
  avatarUrl: string;
}

interface NotionBlock {
  type: string;
  id: string;
  content: string | Array<{ text: string; bold?: boolean; italic?: boolean }>;
  imageUrl?: string;
}

// Initialize state variables
let profileData: ProfileData | null = null;
let introBlocks: NotionBlock[] = [];
let featuredImage: NotionBlock | null = null;
let featuredHeading: NotionBlock | null = null;
let isLoading = true;
let hasError = false;
let errorMessage = "";

// Format the page ID to ensure it's in the correct format
const formatPageId = (id: string): string => {
  // Check if the ID contains hyphens already
  if (id.includes("-")) return id;

  // Convert to hyphenated format: 4be8c525e1394a76ab766b0e74e9f3db → 4be8c525-e139-4a76-ab76-6b0e74e9f3db
  return `${id.slice(0, 8)}-${id.slice(8, 12)}-${id.slice(12, 16)}-${id.slice(16, 20)}-${id.slice(20)}`;
};

// Extract profile data from Notion page
const extractProfileData = (page: any): ProfileData | null => {
  try {
    // Initialize profile data with empty values
    const data: ProfileData = {
      name: "",
      title: "",
      description: "",
      avatarUrl: "",
    };

    // Extract name from page title if available
    if (page.properties?.title?.title?.length > 0) {
      data.name = page.properties.title.title
        .map((t: any) => t.plain_text)
        .join("");
    } else if (page.properties?.Name?.title?.length > 0) {
      data.name = page.properties.Name.title
        .map((t: any) => t.plain_text)
        .join("");
    }

    // Extract title and description from rich text properties
    if (page.properties?.Title?.rich_text?.length > 0) {
      data.title = page.properties.Title.rich_text
        .map((t: any) => t.plain_text)
        .join("");
    }

    if (page.properties?.Description?.rich_text?.length > 0) {
      data.description = page.properties.Description.rich_text
        .map((t: any) => t.plain_text)
        .join("");
    }

    // Extract avatar/profile image (icon or cover)
    if (page.icon) {
      if (page.icon.type === "emoji" && page.icon.emoji) {
        data.avatarUrl = page.icon.emoji;
      } else if (page.icon.type === "external" && page.icon.external?.url) {
        data.avatarUrl = page.icon.external.url;
      } else if (
        page.icon.type === "custom_emoji" &&
        page.icon.custom_emoji?.url
      ) {
        data.avatarUrl = page.icon.custom_emoji.url;
      }
    } else if (page.cover?.type === "external" && page.cover.external.url) {
      data.avatarUrl = page.cover.external.url;
    }

    return data;
  } catch (err) {
    console.error("Error extracting profile data:", err);
    return null;
  }
};

/**
 * Process block content from Notion API
 * @param block - Notion block object
 * @returns Processed block with content
 */
const processBlockContent = (block: any): NotionBlock | null => {
  try {
    if (!block || !block.type) return null;

    const blockType = block.type;
    const blockId = block.id;

    // Skip section headings and callouts
    if (blockType === "callout" || blockType === "column_list") {
      return null;
    }

    let content:
      | string
      | Array<{ text: string; bold?: boolean; italic?: boolean }> = "";
    let imageUrl: string | undefined;

    // Process different block types
    if (blockType === "paragraph") {
      if (block.paragraph?.rich_text?.length > 0) {
        content = block.paragraph.rich_text.map((textItem: any) => ({
          text: textItem.plain_text,
          bold: textItem.annotations?.bold || false,
          italic: textItem.annotations?.italic || false,
        }));
      }
    } else if (
      blockType === "heading_1" ||
      blockType === "heading_2" ||
      blockType === "heading_3"
    ) {
      if (block[blockType]?.rich_text?.length > 0) {
        content = block[blockType].rich_text.map((textItem: any) => ({
          text: textItem.plain_text,
          bold: textItem.annotations?.bold || false,
          italic: textItem.annotations?.italic || false,
        }));
      }
    } else if (blockType === "image") {
      // Handle image blocks
      if (block.image?.type === "external" && block.image.external?.url) {
        imageUrl = block.image.external.url;
      } else if (block.image?.type === "file" && block.image.file?.url) {
        imageUrl = block.image.file.url;
      }

      // Set content to empty array if no caption
      content =
        block.image?.caption?.length > 0
          ? block.image.caption.map((captionItem: any) => ({
              text: captionItem.plain_text,
              bold: captionItem.annotations?.bold || false,
              italic: captionItem.annotations?.italic || false,
            }))
          : [];
    }

    return {
      id: blockId,
      type: blockType,
      content,
      imageUrl,
    };
  } catch (error) {
    console.error("Error processing block:", error);
    return null;
  }
};

try {
  // Ensure we have the required environment variables
  if (!import.meta.env.PUBLIC_NOTION_TOKEN) {
    throw new Error("Missing PUBLIC_NOTION_TOKEN environment variable");
  }

  if (!import.meta.env.PUBLIC_NOTION_PAGE_ID) {
    throw new Error("Missing PUBLIC_NOTION_PAGE_ID environment variable");
  }

  // Use the provided page ID with proper formatting
  const pageId = formatPageId(import.meta.env.PUBLIC_NOTION_PAGE_ID);
  console.log("Fetching Notion page with ID:", pageId);

  // Fetch the page data
  const page = await getPageById(pageId);

  if (!page) {
    hasError = true;
    errorMessage = "Could not fetch page from Notion API";
    console.warn(errorMessage);
  } else {
    // Extract the essential profile data
    profileData = extractProfileData(page);

    if (!profileData) {
      throw new Error("Failed to extract profile data from Notion page");
    }

    // Fetch the page blocks
    const blocksResponse = await getBlockChildren(pageId);

    // Log number of blocks for debugging
    console.log(
      `Fetched ${blocksResponse.results.length} blocks from Notion page`
    );

    // IDs of specific blocks we want to display (without hyphens for comparison)
    const targetImageId = "1d598b9bce6380f7a777c57419a26dfd";
    const targetHeadingId = "00519ead54ea405e823a6e69b70b0f8d";

    if (blocksResponse && blocksResponse.results.length > 0) {
      // Process blocks to extract intro content and our specific blocks
      for (const block of blocksResponse.results) {
        // Check if block is a full BlockObjectResponse (not partial)
        if ("type" in block) {
          // Log each block ID and type for debugging
          console.log(
            `Block: ${block.id.replace(/-/g, "")} of type ${block.type}`
          );

          // Normalize block ID by removing hyphens for comparison
          const normalizedBlockId = block.id.replace(/-/g, "");

          // Process the block content
          const processedBlock = processBlockContent(block);

          if (processedBlock) {
            // Check for our specific image block
            if (normalizedBlockId === targetImageId) {
              console.log(`Found target image block: ${block.id}`);
              featuredImage = processedBlock;
            }
            // Check for our specific heading block
            else if (normalizedBlockId === targetHeadingId) {
              console.log(`Found target heading block: ${block.id}`);
              featuredHeading = processedBlock;
            }
            // Add appropriate blocks to intro blocks collection
            else if (block.type === "callout") {
              // Stop processing at section boundary
              break;
            } else if (
              processedBlock.type === "paragraph" ||
              processedBlock.type.startsWith("heading_")
            ) {
              introBlocks.push(processedBlock);
            }
          }
        }
      }
    }

    console.log("Successfully loaded profile data from Notion");
    console.log(`Loaded ${introBlocks.length} intro blocks`);
  }
} catch (error) {
  hasError = true;
  errorMessage =
    error instanceof Error
      ? error.message
      : "Unknown error fetching Notion data";
  console.error("Error fetching Notion data:", error);
} finally {
  isLoading = false;
}
---

<div class="profile-container">
  {
    hasError || !profileData ? (
      <div class="profile-error">
        <h2>Could not load profile data</h2>
        <p>{errorMessage}</p>
        <p>Check your Notion connection settings or try again later.</p>
        <button class="retry-button" onclick="window.location.reload()">
          Retry
        </button>
      </div>
    ) : (
      <>
        <div class="profile-header">
          {profileData.avatarUrl && profileData.avatarUrl.startsWith("http") ? (
            <img
              src={profileData.avatarUrl}
              alt={profileData.name}
              class="profile-avatar"
            />
          ) : profileData.avatarUrl ? (
            <div class="profile-avatar-emoji">{profileData.avatarUrl}</div>
          ) : (
            <div class="profile-avatar-emoji">👤</div>
          )}
          <div class="profile-title">
            <h1>{profileData.name}</h1>
            <h2>{profileData.title}</h2>
          </div>
        </div>

        {/* Featured image block */}
        {featuredImage && featuredImage.type === "image" && (
          <div class="profile-featured-image">
            <img
              src={featuredImage.imageUrl}
              alt="Featured image"
              class="notion-image"
            />
            {Array.isArray(featuredImage.content) &&
              featuredImage.content.length > 0 && (
                <figcaption class="notion-image-caption">
                  {featuredImage.content.map((text, i) => (
                    <span
                      class:list={{
                        bold: text.bold,
                        italic: text.italic,
                      }}
                    >
                      {text.text}
                    </span>
                  ))}
                </figcaption>
              )}
          </div>
        )}

        {/* Featured heading block */}
        {featuredHeading && featuredHeading.type === "heading_2" && (
          <h2 class="profile-featured-heading">
            {Array.isArray(featuredHeading.content)
              ? featuredHeading.content.map((text, i) => (
                  <span
                    class:list={{
                      bold: text.bold,
                      italic: text.italic,
                    }}
                  >
                    {text.text}
                  </span>
                ))
              : featuredHeading.content}
          </h2>
        )}

        {/* Display intro blocks from Notion */}
        <div class="profile-intro">
          {introBlocks.map((block) => {
            if (block.type === "paragraph") {
              return (
                <p class="profile-paragraph">
                  {Array.isArray(block.content)
                    ? block.content.map((text, i) => (
                        <span
                          class:list={{
                            bold: text.bold,
                            italic: text.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </p>
              );
            } else if (block.type === "heading_1") {
              return (
                <h1 class="profile-heading-1">
                  {Array.isArray(block.content)
                    ? block.content.map((text, i) => (
                        <span
                          class:list={{
                            bold: text.bold,
                            italic: text.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h1>
              );
            } else if (block.type === "heading_2") {
              return (
                <h2 class="profile-heading-2">
                  {Array.isArray(block.content)
                    ? block.content.map((text, i) => (
                        <span
                          class:list={{
                            bold: text.bold,
                            italic: text.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h2>
              );
            } else if (block.type === "heading_3") {
              return (
                <h3 class="profile-heading-3">
                  {Array.isArray(block.content)
                    ? block.content.map((text, i) => (
                        <span
                          class:list={{
                            bold: text.bold,
                            italic: text.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h3>
              );
            }
            return null;
          })}
        </div>
      </>
    )
  }
</div>

<style>
  .profile-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar-emoji {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .profile-title h1 {
    margin: 0;
    font-size: 1.8rem;
    color: var(--text-color, #333);
  }

  .profile-title h2 {
    margin: 0.5rem 0 0;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--secondary-text-color, #666);
  }

  .profile-description {
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .profile-error {
    text-align: center;
    padding: 2rem;
    background-color: #fff5f5;
    border-radius: 8px;
    color: #e53e3e;
  }

  .retry-button {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: #e53e3e;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .retry-button:hover {
    background-color: #c53030;
  }

  /* Add styling for the featured elements */
  .profile-featured-image {
    margin: 2rem 0;
    width: 100%;
  }

  .notion-image {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgb(0 0 0 / 10%);
  }

  .notion-image-caption {
    text-align: center;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--secondary-text-color, #666);
  }

  .profile-featured-heading {
    margin: 1.5rem 0;
    font-size: 1.4rem;
    color: var(--heading-color, #444);
  }

  .profile-intro {
    margin-top: 1rem;
  }

  .profile-paragraph {
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .bold {
    font-weight: bold;
  }

  .italic {
    font-style: italic;
  }

  /* Responsive adjustments */
  @media (width <= 600px) {
    .profile-header {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
