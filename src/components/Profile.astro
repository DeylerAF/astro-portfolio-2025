---
import { getProfileDataAndIntroBlocks } from "../lib/services/notion";
import type {
  ProcessedBlock,
  RichTextItem,
  ProfileData,
} from "../lib/types/notion";

// Initialize state variables
let profileData: ProfileData | null = null;
let introBlocks: ProcessedBlock[] = [];
let isLoading = true;
let hasError = false;
let errorMessage = "";

try {
  // Fetch profile data and intro blocks from Notion service
  const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
  if (!import.meta.env.PUBLIC_NOTION_TOKEN) {
    throw new Error("Missing PUBLIC_NOTION_TOKEN environment variable");
  }
  if (!pageId) {
    throw new Error("Missing PUBLIC_NOTION_PAGE_ID environment variable");
  }
  const result = await getProfileDataAndIntroBlocks(pageId);
  profileData = result.profileData;
  introBlocks = result.introBlocks;
  if (!profileData) {
    hasError = true;
    errorMessage = "Could not fetch page from Notion API";
  }
} catch (error) {
  hasError = true;
  errorMessage =
    error instanceof Error
      ? error.message
      : "Unknown error fetching Notion data";
  console.error("Error fetching Notion data:", error);
} finally {
  isLoading = false;
}
---

<div class="profile-container">
  {
    hasError || !profileData ? (
      <div class="profile-error">
        <h2>Could not load profile data</h2>
        <p>{errorMessage}</p>
        <p>Check your Notion connection settings or try again later.</p>
        <button class="retry-button" onclick="window.location.reload()">
          Retry
        </button>
      </div>
    ) : (
      <>
        <div class="profile-header">
          {profileData.avatarUrl && profileData.avatarUrl.startsWith("http") ? (
            <img
              src={profileData.avatarUrl}
              alt={profileData.name}
              class="profile-avatar"
            />
          ) : profileData.avatarUrl ? (
            <div class="profile-avatar-emoji">{profileData.avatarUrl}</div>
          ) : (
            <div class="profile-avatar-emoji">👤</div>
          )}
          <div class="profile-title">
            <h1>{profileData.name}</h1>
            <h2>{profileData.title}</h2>
          </div>
        </div>

        {/* Display intro blocks from Notion */}
        <div class="profile-intro">
          {introBlocks.map((block) => {
            if (block.type === "paragraph") {
              return (
                <p class="profile-paragraph">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </p>
              );
            } else if (block.type === "heading_1") {
              return (
                <h1 class="profile-heading-1">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h1>
              );
            } else if (block.type === "heading_2") {
              return (
                <h2 class="profile-heading-2">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h2>
              );
            } else if (block.type === "heading_3") {
              return (
                <h3 class="profile-heading-3">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            bold: text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h3>
              );
            } else if (
              block.type === "image" &&
              typeof block.content === "object" &&
              block.content &&
              "url" in block.content
            ) {
              return (
                <figure class="profile-image-container">
                  <img
                    src={block.content.url as string}
                    alt={
                      block.content.caption
                        ? String(block.content.caption)
                        : "Profile image"
                    }
                    class="profile-image"
                  />
                  {block.content.caption && (
                    <figcaption class="profile-image-caption">
                      {String(block.content.caption)}
                    </figcaption>
                  )}
                </figure>
              );
            }
            return null;
          })}
        </div>
      </>
    )
  }
</div>

<style>
  .profile-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .profile-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar-emoji {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background-color: #f0f0f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
  }

  .profile-title h1 {
    margin: 0;
    font-size: 1.8rem;
    color: var(--text-color, #333);
  }

  .profile-title h2 {
    margin: 0.5rem 0 0;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--secondary-text-color, #666);
  }

  .profile-description {
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .profile-error {
    text-align: center;
    padding: 2rem;
    background-color: #fff5f5;
    border-radius: 8px;
    color: #e53e3e;
  }

  .retry-button {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: #e53e3e;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .retry-button:hover {
    background-color: #c53030;
  }

  /* Estilos para imágenes */
  .profile-image-container {
    margin: 1.5rem 0;
    width: 100%;
  }

  .profile-image {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    margin: 0 auto;
  }

  .profile-image-caption {
    text-align: center;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--secondary-text-color, #666);
    font-style: italic;
  }

  /* Responsive adjustments */
  @media (width <= 600px) {
    .profile-header {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
