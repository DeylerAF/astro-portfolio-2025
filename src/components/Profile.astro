---
import { getProfileDataAndIntroBlocks } from "../lib/services/notion/notionProfile";
import type {
  ProcessedBlock,
  RichTextItem,
  ProfileData,
} from "../lib/types/notion";

// Initialize state variables
let profileData: ProfileData | null = null;
let introBlocks: ProcessedBlock[] = [];
let isLoading = true;
let hasError = false;
let errorMessage = "";

try {
  // Fetch profile data and intro blocks from Notion service
  const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
  if (!import.meta.env.PUBLIC_NOTION_TOKEN) {
    throw new Error("Missing PUBLIC_NOTION_TOKEN environment variable");
  }
  if (!pageId) {
    throw new Error("Missing PUBLIC_NOTION_PAGE_ID environment variable");
  }
  const result = await getProfileDataAndIntroBlocks(pageId);
  profileData = result.profileData;
  introBlocks = result.introBlocks;
  if (!profileData) {
    hasError = true;
    errorMessage = "Could not fetch page from Notion API";
  }
} catch (error) {
  hasError = true;
  errorMessage =
    error instanceof Error
      ? error.message
      : "Unknown error fetching Notion data";
  console.error("Error fetching Notion data:", error);
} finally {
  isLoading = false;
}
---

<div class="max-w-2xl mx-auto p-8 font-sans">
  {
    hasError || !profileData ? (
      <div class="text-center p-8 bg-red-50 rounded-lg text-red-600">
        <h2 class="text-2xl font-bold mb-2">Could not load profile data</h2>
        <p class="mb-1">{errorMessage}</p>
        <p class="mb-4">Check your Notion connection settings or try again later.</p>
        <button class="mt-2 px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 transition" onclick="window.location.reload()">
          Retry
        </button>
      </div>
    ) : (
      <>
        {/* Display intro blocks from Notion */}
        <div class="flex flex-col gap-4">
          {introBlocks.map((block) => {
            if (block.type === "paragraph") {
              return (
                <p class="text-lg text-gray-800 dark:text-gray-300 leading-relaxed">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            "font-bold": text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </p>
              );
            } else if (block.type === "heading_1") {
              return (
                <h1 class="text-2xl font-bold text-gray-900 dark:text-white mt-6 mb-2">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            "font-bold": text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h1>
              );
            } else if (block.type === "heading_2") {
              return (
                <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mt-4 mb-1">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            "font-bold": text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h2>
              );
            } else if (block.type === "heading_3") {
              return (
                <h3 class="text-lg font-medium text-gray-700 dark:text-gray-300 mt-2 mb-1">
                  {Array.isArray(block.content)
                    ? (block.content as RichTextItem[]).map((text, i) => (
                        <span
                          class:list={{
                            "font-bold": text.annotations?.bold,
                            italic: text.annotations?.italic,
                          }}
                        >
                          {text.text}
                        </span>
                      ))
                    : block.content}
                </h3>
              );
            } else if (
              block.type === "image" &&
              typeof block.content === "object" &&
              block.content &&
              "url" in block.content
            ) {
              return (
                <figure class="my-6 w-full">
                  <img
                    src={block.content.url as string}
                    alt={block.content.caption ? String(block.content.caption) : "Profile image"}
                    class="max-w-full h-auto rounded-lg mx-auto shadow"
                  />
                  {block.content.caption && (
                    <figcaption class="text-center mt-2 text-sm text-gray-500 italic">
                      {String(block.content.caption)}
                    </figcaption>
                  )}
                </figure>
              );
            }
            return null;
          })}
        </div>
      </>
    )
  }
</div>
