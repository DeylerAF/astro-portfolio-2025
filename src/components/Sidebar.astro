---
// Props for the sidebar component
interface Props {
  isOpen?: boolean;
}

import { Home, FolderKanban, PanelLeft, PanelLeftClose } from "lucide-astro";

const { isOpen = false } = Astro.props;
---

<div
  id="sidebar"
  class={`fixed top-0 left-0 h-full shadow-md transition-all duration-300 ease-in-out z-20 overflow-y-auto overflow-x-hidden bg-[var(--sidebar-bg)] text-[var(--sidebar-text)] ${isOpen ? "w-64" : "w-16"}`}
>
  <div class="flex justify-end p-3">
    <button
      id="toggle-sidebar"
      class="p-2 rounded transition-colors hover:bg-[var(--sidebar-hover)]"
      aria-label="Toggle Sidebar"
    >
      {
        isOpen ? (
          <PanelLeftClose id="sidebar-close-icon" class="w-5 h-5" />
        ) : (
          <PanelLeft id="sidebar-open-icon" class="w-5 h-5" />
        )
      }
    </button>
  </div>

  <div class="mt-4">
    <ul>
      <li class="mb-2">
        <a
          href="/"
          class={`flex items-center py-2 px-4 transition-colors text-[var(--sidebar-text)] hover:bg-[var(--sidebar-hover)] hover:text-[var(--accent-color)] ${isOpen ? "" : "justify-center"}`}
        >
          <Home class="w-5 h-5" />
          <span class={`ml-3 ${isOpen ? "block" : "hidden"}`}>Home</span>
        </a>
      </li>
      <li class="mb-2">
        <a
          href="/projects"
          class={`flex items-center py-2 px-4 transition-colors text-[var(--sidebar-text)] hover:bg-[var(--sidebar-hover)] hover:text-[var(--accent-color)] ${isOpen ? "" : "justify-center"}`}
        >
          <FolderKanban class="w-5 h-5" />
          <span class={`ml-3 ${isOpen ? "block" : "hidden"}`}>Projects</span>
        </a>
      </li>
      <!-- Add more navigation links as needed -->
    </ul>
  </div>
</div>

<script>
  // Client-side script for toggling sidebar
  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById("sidebar");
    const toggleBtn = document.getElementById("toggle-sidebar");
    const content = document.getElementById("content");

    toggleBtn?.addEventListener("click", () => {
      // Toggle sidebar width class
      sidebar?.classList.toggle("w-64");
      sidebar?.classList.toggle("w-16");

      // Toggle content margin when sidebar expands/collapses
      content?.classList.toggle("ml-16");
      content?.classList.toggle("ml-64");

      // Toggle visibility of text in sidebar items
      const textLabels = document.querySelectorAll("#sidebar span");
      textLabels.forEach((label) => {
        label.classList.toggle("hidden");
        label.classList.toggle("block");
      });

      // Toggle between open/close icons
      const openIcon = document.getElementById("sidebar-open-icon");
      const closeIcon = document.getElementById("sidebar-close-icon");

      if (openIcon && closeIcon) {
        if (sidebar?.classList.contains("w-64")) {
          openIcon.style.display = "none";
          closeIcon.style.display = "block";
        } else {
          openIcon.style.display = "block";
          closeIcon.style.display = "none";
        }
      }
    });
  });
</script>
