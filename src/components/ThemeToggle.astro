---
import { Sun, Moon, Monitor, ChevronDown } from "lucide-astro";
---

<div class="theme-toggle-container relative">
  <button
    id="theme-toggle-button"
    title="Toggle theme options"
    class="p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)] flex items-center gap-1"
    aria-label="Toggle theme options"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span id="current-theme-icon">
      <!-- Theme icons - only one will be visible based on current theme -->
      <Sun class="w-5 h-5 theme-icon" id="light-icon" />
      <Moon class="w-5 h-5 theme-icon hidden" id="dark-icon" />
      <Monitor class="w-5 h-5 theme-icon hidden" id="system-icon" />
    </span>
    <ChevronDown class="w-4 h-4 transition-transform" id="dropdown-chevron" />
  </button>

  <div
    id="theme-dropdown"
    class="absolute top-full right-0 mt-1 p-1 bg-[var(--card-bg)] border border-[var(--border-color)] rounded-md shadow-md hidden z-50"
  >
    <button
      id="theme-toggle-light"
      title="Use light theme"
      class="flex items-center gap-2 w-full p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)]"
      aria-label="Use light theme"
    >
      <Sun class="w-5 h-5" />
      <span class="text-sm">Light</span>
    </button>
    <button
      id="theme-toggle-dark"
      title="Use dark theme"
      class="flex items-center gap-2 w-full p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)]"
      aria-label="Use dark theme"
    >
      <Moon class="w-5 h-5" />
      <span class="text-sm">Dark</span>
    </button>
    <button
      id="theme-toggle-system"
      title="Use system theme"
      class="flex items-center gap-2 w-full p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)]"
      aria-label="Use system theme"
    >
      <Monitor class="w-5 h-5" />
      <span class="text-sm">System</span>
    </button>
  </div>
</div>

<script>
  import {
    getThemePreference,
    applyTheme,
    setupThemeListener,
    updateButtonState,
    type ThemeType,
  } from "../lib/utils/theme";

  document.addEventListener("DOMContentLoaded", () => {
    // Element references
    const elements = {
      dropdown: document.getElementById("theme-dropdown"),
      toggleButton: document.getElementById("theme-toggle-button"),
      chevron: document.getElementById("dropdown-chevron"),
      icons: {
        light: document.getElementById("light-icon"),
        dark: document.getElementById("dark-icon"),
        system: document.getElementById("system-icon"),
      },
      themeButtons: {
        light: document.getElementById("theme-toggle-light"),
        dark: document.getElementById("theme-toggle-dark"),
        system: document.getElementById("theme-toggle-system"),
      },
    };

    const { dropdown, toggleButton, chevron } = elements;

    // Early exit if required elements are missing
    if (!dropdown || !toggleButton || !chevron) return;

    // Function to update the main button icon
    const updateMainButtonIcon = (theme: ThemeType) => {
      // Hide all icons first
      Object.values(elements.icons).forEach((icon) => {
        if (icon) icon.classList.add("hidden");
      });

      // Show the active theme icon
      const activeIcon = elements.icons[theme];
      if (activeIcon) {
        activeIcon.classList.remove("hidden");
      }
    };

    // Update both button states and main icon
    const updateThemeUI = (theme: ThemeType) => {
      updateButtonState(
        theme,
        elements.themeButtons as Record<ThemeType, HTMLElement | null>
      );
      updateMainButtonIcon(theme);
    };

    // Toggle dropdown visibility
    const toggleDropdown = () => {
      const isVisible = !dropdown.classList.contains("hidden");

      dropdown.classList.toggle("hidden", isVisible);
      chevron.classList.toggle("rotate-180", !isVisible);
      toggleButton.setAttribute("aria-expanded", isVisible ? "false" : "true");
    };

    // Close dropdown if clicked outside
    const handleOutsideClick = (e: MouseEvent) => {
      if (
        !dropdown.classList.contains("hidden") &&
        e.target instanceof Node &&
        !toggleButton.contains(e.target) &&
        !dropdown.contains(e.target)
      ) {
        dropdown.classList.add("hidden");
        chevron.classList.remove("rotate-180");
        toggleButton.setAttribute("aria-expanded", "false");
      }
    };

    // Handle theme change
    const changeTheme = (theme: ThemeType) => {
      applyTheme(theme);
      updateThemeUI(theme);
      toggleDropdown(); // Close dropdown after selection
    };

    // Initialize UI
    const currentTheme = getThemePreference();
    updateThemeUI(currentTheme);

    // Add event listeners
    toggleButton.addEventListener("click", toggleDropdown);
    document.addEventListener("click", handleOutsideClick);

    // Theme toggle buttons
    Object.entries(elements.themeButtons).forEach(([theme, button]) => {
      if (button) {
        button.addEventListener("click", () => changeTheme(theme as ThemeType));
      }
    });

    // Setup listener for system preference changes
    setupThemeListener();

    // Keyboard navigation support
    toggleButton.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !dropdown.classList.contains("hidden")) {
        toggleDropdown();
      }
    });
  });
</script>
