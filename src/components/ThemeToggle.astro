---
import { Sun, Moon, Monitor } from "lucide-astro";
---

<div class="flex gap-2 p-2">
  <button
    id="theme-toggle-light"
    title="Use light theme"
    class="p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)]"
    aria-label="Use light theme"
  >
    <Sun class="w-5 h-5" />
  </button>
  <button
    id="theme-toggle-dark"
    title="Use dark theme"
    class="p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)]"
    aria-label="Use dark theme"
  >
    <Moon class="w-5 h-5" />
  </button>
  <button
    id="theme-toggle-system"
    title="Use system theme"
    class="p-2 rounded-md transition-colors hover:bg-[var(--hover-bg)] text-[var(--text-color)]"
    aria-label="Use system theme"
  >
    <Monitor class="w-5 h-5" />
  </button>
</div>

<script>
  import {
    getThemePreference,
    applyTheme,
    setupThemeListener,
    type ThemeType,
  } from "../lib/utils/theme";

  // Set the theme according to user preference
  const themeToggles: Record<ThemeType, HTMLElement | null> = {
    light: document.getElementById("theme-toggle-light"),
    dark: document.getElementById("theme-toggle-dark"),
    system: document.getElementById("theme-toggle-system"),
  };

  // Update buttons active state
  function updateButtonState(theme: ThemeType): void {
    (Object.keys(themeToggles) as ThemeType[]).forEach((key) => {
      if (themeToggles[key]) {
        if (key === theme) {
          themeToggles[key]!.classList.add("text-[var(--accent-color)]");
        } else {
          themeToggles[key]!.classList.remove("text-[var(--accent-color)]");
        }
      }
    });
  }

  // Set up event listeners for theme toggle buttons
  document.addEventListener("DOMContentLoaded", () => {
    const currentTheme = getThemePreference();
    updateButtonState(currentTheme);

    // Light theme button
    themeToggles.light?.addEventListener("click", () => {
      applyTheme("light");
      updateButtonState("light");
    });

    // Dark theme button
    themeToggles.dark?.addEventListener("click", () => {
      applyTheme("dark");
      updateButtonState("dark");
    });

    // System theme button
    themeToggles.system?.addEventListener("click", () => {
      applyTheme("system");
      updateButtonState("system");
    });

    // Setup listener for system preference changes
    setupThemeListener();
  });
</script>
