---
// Centralized Button component imports all button variants
import OutlineButton from "./OutlineButton.astro";
import SpinButton from "./SpinButton.astro";
import type { ButtonProps } from "../../lib/utils/buttonUtils";
import {
  getButtonInitialSize,
  getResponsiveButtonDataAttrs,
} from "../../lib/utils/buttonUtils";

const {
  variant = "outlineButton",
  size = "normal",
  responsiveSize = false,
  responsiveSizeConfig = {
    mobile: "small",
    tablet: "normal",
    desktop: "normal",
    largeDesktop: "large",
  },
  ...rest
} = Astro.props as ButtonProps;

const initialSize = getButtonInitialSize(
  size,
  responsiveSize,
  responsiveSizeConfig,
);
const responsiveAttrs = getResponsiveButtonDataAttrs(
  responsiveSize,
  responsiveSizeConfig,
);
---

{
  variant === "spinButton" ? (
    <SpinButton size={initialSize} {...rest} {...responsiveAttrs} />
  ) : (
    <OutlineButton size={initialSize} {...rest} {...responsiveAttrs} />
  )
}
