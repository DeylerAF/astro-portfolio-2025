---
// SpinButton.astro - Animated border button variant
import type { ButtonProps } from "../../lib/utils/buttonUtils";
import {
  getButtonVars,
  getLinkAttrs,
  getButtonSizeClass,
} from "../../lib/utils/buttonUtils";

const {
  text,
  icon: Icon,
  iconPosition = "left",
  type = "button",
  disabled = false,
  color = "accent",
  size = "normal",
  url,
  target,
  rel,
  ...rest
} = Astro.props as ButtonProps;

const buttonVars = getButtonVars(color);
const { target: linkTarget, rel: linkRel } = getLinkAttrs(url, target, rel);
const gradientClass = `spin-btn-${color}`;
const sizeClass = getButtonSizeClass(size);
---

<span
  class={`relative inline-block overflow-hidden rounded-lg border-2 border-[var(--button-accent-bg)]
${disabled ? "border-[var(--neutral-200)]" : "hover:border-[var(--button-accent-hover)]"}`}
>
  {/* Animated border background */}
  <span
    class={`absolute inset-[-1000%] pointer-events-none animate-[spin_2s_linear_infinite] rounded-lg ${gradientClass}`}
  ></span>
  {
    url ? (
      <a
        href={url}
        target={linkTarget}
        rel={linkRel}
        class={`flex items-center justify-center rounded-lg backdrop-blur-xl bg-transparent focus:outline-none spin-btn-text-shadow ${sizeClass} ${disabled ? "text-[var(--neutral-400)]" : "text-[var(--text-color)]"}`}
        aria-disabled={disabled}
        tabindex={disabled ? -1 : undefined}
        {...rest}
      >
        <div class="relative z-20 flex items-center justify-center">
          {iconPosition === "left" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 me-2" aria-hidden="true" />
          )}
          <span>{text}</span>
          {iconPosition === "right" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
          )}
        </div>
      </a>
    ) : (
      <button
        type={type}
        disabled={disabled}
        class={`flex items-center justify-center rounded-lg backdrop-blur-xl bg-transparent focus:outline-none spin-btn-text-shadow ${sizeClass} ${disabled ? "text-[var(--neutral-400)]" : "text-[var(--text-color)]"}`}
        {...rest}
      >
        <div class="relative z-20 flex items-center justify-center">
          {iconPosition === "left" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 me-2" aria-hidden="true" />
          )}
          <span>{text}</span>
          {iconPosition === "right" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
          )}
        </div>
      </button>
    )
  }
</span>
