---
// SpinButton.astro - Animated border button variant
import type { ButtonProps } from "../../lib/utils/buttonUtils";
import { getButtonVars, getLinkAttrs } from "../../lib/utils/buttonUtils";

const {
  text,
  icon: Icon,
  iconPosition = "left",
  type = "button",
  disabled = false,
  color = "accent",
  size = "normal",
  url,
  target,
  rel,
  ...rest
} = Astro.props as ButtonProps;

const buttonVars = getButtonVars(color);
const { target: linkTarget, rel: linkRel } = getLinkAttrs(url, target, rel);
const gradientClass = `spin-btn-${color}`;
import { getButtonSizeClass } from "../../lib/utils/buttonUtils";
const sizeClass = getButtonSizeClass(size);
---

<span
  class={`relative inline-block overflow-hidden rounded-lg border-2 border-[var(--border-color)]`}
>
  {/* Animated border background */}
  <span
    class={`absolute inset-[-1000%] pointer-events-none animate-[spin_2s_linear_infinite] rounded-lg ${gradientClass}`}
  ></span>
  {
    url ? (
      <a
        href={url}
        target={linkTarget}
        rel={linkRel}
        class={`relative z-10 rounded-lg bg-transparent p-0 border-none focus:outline-none text-[var(--text-color)] hover:text-[var(--text-color)] disabled:text-[var(--neutral-400)]`}
        aria-disabled={disabled}
        tabindex={disabled ? -1 : undefined}
        {...rest}
      >
        <div
          class={`relative z-20 flex items-center justify-center font-medium rounded-lg backdrop-blur-xl transition-colors duration-200 ${sizeClass}`}
        >
          {iconPosition === "left" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 me-2" aria-hidden="true" />
          )}
          <span>{text}</span>
          {iconPosition === "right" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
          )}
        </div>
      </a>
    ) : (
      <button
        type={type}
        disabled={disabled}
        class={`relative z-10 rounded-lg bg-transparent p-0 border-none focus:outline-none text-[var(--text-color)] hover:text-[var(--text-color)] disabled:text-[var(--neutral-400)]`}
        {...rest}
      >
        <div
          class={`relative z-20 flex items-center justify-center font-medium rounded-lg backdrop-blur-xl transition-colors duration-200 ${sizeClass}`}
        >
          {iconPosition === "left" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 me-2" aria-hidden="true" />
          )}
          <span>{text}</span>
          {iconPosition === "right" && typeof Icon === "function" && (
            <Icon class="w-4 h-4 ms-2" aria-hidden="true" />
          )}
        </div>
      </button>
    )
  }
</span>
