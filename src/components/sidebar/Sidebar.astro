---
// Props for the sidebar component
interface Props {
  isOpen?: boolean;
}

import { Home, FolderKanban } from "lucide-astro";
import SidebarToggle from "./SidebarToggle.astro";

// Inicializamos el valor de isOpen desde las props, sin intentar detectar dispositivo del lado del servidor
const { isOpen = false } = Astro.props;
---

<div
  id="sidebar"
  class="fixed top-0 left-0 h-full shadow-md transition-all duration-300 ease-in-out z-30 overflow-y-auto overflow-x-hidden bg-[var(--sidebar-bg)] text-[var(--sidebar-text)]
  -translate-x-full md:translate-x-0
  w-[16rem] md:w-16"
>
  <div class="hidden md:flex justify-end p-3">
    <SidebarToggle />
  </div>

  <div class="mt-4">
    <ul>
      <li class="mb-2">
        <a
          href="/"
          class="flex items-center py-2 px-4 transition-colors text-[var(--sidebar-text)] hover:bg-[var(--sidebar-hover)] hover:text-[var(--accent-color)] md:justify-center"
        >
          <Home class="w-5 h-5" />
          <span class="ml-3 hidden">Home</span>
        </a>
      </li>
      <li class="mb-2">
        <a
          href="/projects"
          class="flex items-center py-2 px-4 transition-colors text-[var(--sidebar-text)] hover:bg-[var(--sidebar-hover)] hover:text-[var(--accent-color)] md:justify-center"
        >
          <FolderKanban class="w-5 h-5" />
          <span class="ml-3 hidden">Projects</span>
        </a>
      </li>
      <!-- Add more navigation links as needed -->
    </ul>
  </div>
</div>
