---
import { Home, FolderKanban } from "lucide-astro";
import SidebarToggle from "./SidebarToggle.astro";

// Get current path to determine active link
const { pathname } = Astro.url;
---

<div
  id="sidebar"
  class="fixed top-0 left-0 h-full shadow-md transition-all duration-300 ease-in-out z-40 overflow-y-auto overflow-x-hidden bg-[var(--sidebar-bg)] text-[var(--sidebar-text)]
  -translate-x-full md:translate-x-0
  w-[16rem]"
>
  <div class="flex justify-between items-center p-3">
    <SidebarToggle />
  </div>

  <div class="mt-4">
    <nav aria-label="Main Navigation">
      <ul>
        <li class="mb-2">
          <a
            href="/"
            class={`flex items-center py-2 px-4 transition-colors hover:bg-[var(--sidebar-hover)] hover:text-[var(--accent-color)] relative
            ${pathname === "/" ? "text-[var(--accent-color)] font-medium" : "text-[var(--sidebar-text)]"}`}
            aria-current={pathname === "/" ? "page" : undefined}
          >
            <Home class="w-5 h-5" />
            <span class="ml-3">Home</span>
            {
              pathname === "/" && (
                <span
                  class="absolute left-0 top-0 bottom-0 w-1 bg-[var(--accent-color)]"
                  aria-hidden="true"
                />
              )
            }
          </a>
        </li>
        <li class="mb-2">
          <a
            href="/projects"
            class={`flex items-center py-2 px-4 transition-colors hover:bg-[var(--sidebar-hover)] hover:text-[var(--accent-color)] relative
            ${pathname === "/projects" ? "text-[var(--accent-color)] font-medium" : "text-[var(--sidebar-text)]"}`}
            aria-current={pathname === "/projects" ? "page" : undefined}
          >
            <FolderKanban class="w-5 h-5" />
            <span class="ml-3">Projects</span>
            {
              pathname === "/projects" && (
                <span
                  class="absolute left-0 top-0 bottom-0 w-1 bg-[var(--accent-color)]"
                  aria-hidden="true"
                />
              )
            }
          </a>
        </li>
        <!-- Add more navigation links as needed -->
      </ul>
    </nav>
  </div>
</div>
