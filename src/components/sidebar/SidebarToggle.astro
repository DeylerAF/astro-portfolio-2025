---
// Props for the SidebarToggle component
interface Props {
  isOpen?: boolean;
}

import { PanelLeft, PanelLeftClose } from "lucide-astro";

const { isOpen = true } = Astro.props;
---

<button
  class="toggle-sidebar p-2 rounded transition-colors hover:bg-[var(--sidebar-hover)]"
  aria-label="Toggle Sidebar"
>
  <PanelLeftClose
    id="sidebar-close-icon"
    class="w-5 h-5"
    style={isOpen ? "" : "display: none;"}
  />
  <PanelLeft
    id="sidebar-open-icon"
    class="w-5 h-5"
    style={isOpen ? "display: none;" : ""}
  />
</button>

<script>
  // Import utility functions
  import {
    initializeSidebar,
    toggleSidebar,
    updateSidebarIcons,
    type SidebarState,
  } from "../../lib/utils/sidebar";

  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById("sidebar");
    const toggleBtn = document.getElementsByClassName("toggle-sidebar");
    const content = document.getElementById("content");
    const layoutToggle = document.getElementById("layout-sidebar-toggle");

    if (!sidebar || !content) return;

    const openIcon = document.getElementById("sidebar-open-icon");
    const closeIcon = document.getElementById("sidebar-close-icon");

    if (!openIcon || !closeIcon) return;

    // Initialize sidebar and state
    let state: SidebarState = initializeSidebar(sidebar, content, layoutToggle);

    // Initial icon update
    updateSidebarIcons(openIcon, closeIcon, state, layoutToggle);

    // Add click handlers to all sidebar toggle buttons
    Array.from(toggleBtn).forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!sidebar || !content) return;

        // Toggle sidebar and get new state
        state.isOpen = toggleSidebar(sidebar, content, state.isOpen);

        // Update icons based on new state
        updateSidebarIcons(openIcon, closeIcon, state, layoutToggle);
      });
    });

    // Handle window resize
    window.addEventListener("resize", () => {
      const previousState = { ...state };
      const isMobileViewNow = window.innerWidth < 768;

      // Only reinitialize if viewport type changed (mobile/desktop switch)
      if (previousState.isMobileView !== isMobileViewNow) {
        state = initializeSidebar(sidebar, content, layoutToggle);
        updateSidebarIcons(openIcon, closeIcon, state, layoutToggle);
      }
    });
  });
</script>
