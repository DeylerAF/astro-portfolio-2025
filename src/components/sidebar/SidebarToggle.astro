---
import { PanelLeft, PanelLeftClose } from "lucide-astro";

interface Props {
  isOpen?: boolean;
}

const { isOpen = true } = Astro.props;
---

<button
  class="toggle-sidebar p-2 rounded-md transition-colors hover:bg-[var(--sidebar-hover)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-color)] focus:ring-opacity-50"
  aria-label="Toggle Sidebar"
  aria-expanded={isOpen ? "true" : "false"}
  aria-controls="sidebar"
>
  <PanelLeftClose
    id="sidebar-close-icon"
    class="w-5 h-5"
    style={isOpen ? "" : "display: none;"}
    aria-hidden="true"
  />
  <PanelLeft
    id="sidebar-open-icon"
    class="w-5 h-5"
    style={isOpen ? "display: none;" : ""}
    aria-hidden="true"
  />
</button>

<script>
  import {
    initializeSidebar,
    toggleSidebar,
    updateSidebarIcons,
    type SidebarState,
  } from "../../lib/utils/sidebar";
  import { getViewportWidth, breakpoints } from "../../lib/utils/responsive";

  document.addEventListener("DOMContentLoaded", () => {
    // Get all required elements
    const elements = {
      sidebar: document.getElementById("sidebar"),
      content: document.getElementById("content"),
      toggleButtons: document.querySelectorAll<HTMLElement>(".toggle-sidebar"),
      layoutToggle: document.getElementById("layout-sidebar-toggle"),
      overlay: document.getElementById("sidebar-overlay"),
      openIcon: document.getElementById("sidebar-open-icon"),
      closeIcon: document.getElementById("sidebar-close-icon"),
    };

    const {
      sidebar,
      content,
      toggleButtons,
      layoutToggle,
      overlay,
      openIcon,
      closeIcon,
    } = elements;

    // Exit if required elements are missing
    if (!sidebar || !content || !openIcon || !closeIcon) return;

    // Initialize sidebar state
    let state: SidebarState = initializeSidebar(sidebar, content, layoutToggle);

    // Set initial icon visibility and ARIA attributes
    updateSidebarIcons(openIcon, closeIcon, state, layoutToggle);
    updateAriaAttributes();

    // Handler for toggling sidebar
    const handleToggleSidebar = () => {
      if (!sidebar || !content) return;

      state.isOpen = toggleSidebar(sidebar, content, state.isOpen);
      updateSidebarIcons(openIcon, closeIcon, state, layoutToggle);
      updateAriaAttributes();
    };

    // Handler for closing sidebar on mobile
    const closeSidebarOnMobile = () => {
      if (state.isOpen && state.isMobileView) {
        handleToggleSidebar();
      }
    };

    // Function to update ARIA attributes
    function updateAriaAttributes() {
      toggleButtons.forEach((btn) => {
        btn.setAttribute("aria-expanded", state.isOpen ? "true" : "false");
      });
    }

    // Add click handler to toggle buttons
    toggleButtons.forEach((btn) => {
      btn.addEventListener("click", handleToggleSidebar);
    });

    // Add click handler to overlay
    if (overlay) {
      overlay.addEventListener("click", closeSidebarOnMobile);
    }

    // Handle viewport changes
    window.addEventListener("resize", () => {
      const viewportWidth = getViewportWidth();
      const isMobileViewNow = viewportWidth < breakpoints.md;

      // Only reinitialize if viewport type changed
      if (state.isMobileView !== isMobileViewNow) {
        state = initializeSidebar(sidebar, content, layoutToggle);
        updateSidebarIcons(openIcon, closeIcon, state, layoutToggle);
        updateAriaAttributes();
      }
    });

    // Add keyboard support
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && state.isOpen && state.isMobileView) {
        handleToggleSidebar();
      }
    });
  });
</script>
