---
import "../styles/global.css";
import Sidebar from "../components/sidebar/Sidebar.astro";
import SidebarToggle from "../components/sidebar/SidebarToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { PanelLeft, PanelLeftClose } from "lucide-astro";
import { initializeTheme } from "../lib/utils/theme";

interface Props {
  title?: string;
}

const { title = "Astro Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Minimal theme initialization script to prevent flash -->
    <script is:inline>
      const theme = localStorage.getItem("theme") || "system";
      const isDark =
        theme === "dark" ||
        (theme === "system" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches);

      document.documentElement.classList.add(isDark ? "dark" : "light");
    </script>
  </head>
  <body class="flex">
    <Sidebar />
    <div
      id="content"
      class="md:ml-16 flex-grow transition-all duration-300 ease-in-out"
    >
      <div class="fixed top-4 left-4 z-30 md:hidden">
        <SidebarToggle />
      </div>
      <div class="fixed top-4 right-4 z-30">
        <ThemeToggle />
      </div>
      <slot />
    </div>
  </body>
</html>
