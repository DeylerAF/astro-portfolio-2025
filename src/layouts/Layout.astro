---
import "../styles/global.css";
import Sidebar from "../components/sidebar/Sidebar.astro";
import Header from "../components/Header.astro";
import { generateInitializationScript } from "../lib/utils/theme";

interface Props {
  title?: string;
}

const { title = "Astro Portfolio" } = Astro.props;
const themeInitScript = generateInitializationScript();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="My personal portfolio built with Astro" />
    <title>{title}</title>
    <!-- Theme initialization script with system preference detection -->
    <script is:inline set:html={themeInitScript} />
  </head>
  <body class="flex min-h-screen bg-[var(--body-bg)] text-[var(--text-color)]">
    <!-- Backdrop overlay for mobile when sidebar is open -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/30 backdrop-blur-sm z-30 hidden md:hidden"
      aria-hidden="true"
    >
    </div>

    <Sidebar />
    <div
      id="content"
      class="md:ml-16 flex-grow transition-all duration-300 ease-in-out max-w-full overflow-x-hidden flex flex-col"
    >
      <!-- Header component -->
      <Header />
      <!-- Main content without margin top since header is now in content flow -->
      <main class="p-4 md:p-6 container mx-auto max-w-6xl">
        <slot />
      </main>
      <!-- Footer -->
      <footer class="mt-auto py-4 text-center text-sm opacity-75">
        &copy; {new Date().getFullYear()} My Portfolio. Built with Astro.
      </footer>
    </div>
  </body>
</html>
