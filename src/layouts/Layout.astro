---
import "../styles/global.css";
import Sidebar from "../components/sidebar/Sidebar.astro";
import Header from "../components/Header.astro";
import {
  THEME_STORAGE_KEY,
  THEME_CLASSES,
  THEME_ACCENT_CLASS,
  getThemePreference,
  resolveTheme,
} from "../lib/utils/theme";

// Pre-compute some values for the inline script
const preferenceFunction = getThemePreference.toString();
const resolveFunction = resolveTheme.toString();

interface Props {
  title?: string;
}

const { title = "Astro Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Minimal theme initialization script to prevent flash -->
    <script
      is:inline
      define:vars={{
        THEME_STORAGE_KEY,
        THEME_CLASSES,
        THEME_ACCENT_CLASS,
        preferenceFunction,
        resolveFunction,
      }}
    >
      // Recreate necessary functions from their string representations
      const systemPrefersDark = () =>
        window.matchMedia("(prefers-color-scheme: dark)").matches;
      const getThemePreference = new Function("return " + preferenceFunction)();
      const resolveTheme = new Function("return " + resolveFunction)();

      // Get theme preference using the imported function
      const preference = getThemePreference();

      // Remove any existing theme classes
      document.documentElement.classList.remove(
        THEME_CLASSES.light,
        THEME_CLASSES.dark
      );

      // Resolve and apply the appropriate theme class
      const themeToApply = resolveTheme(preference);
      document.documentElement.classList.add(themeToApply);
    </script>
  </head>
  <body class="flex">
    <!-- Backdrop overlay for mobile when sidebar is open -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/30 backdrop-blur-sm z-40 hidden md:hidden"
      aria-hidden="true"
    >
    </div>

    <Sidebar />
    <div
      id="content"
      class="md:ml-16 flex-grow transition-all duration-300 ease-in-out"
    >
      <!-- Header component -->
      <Header />
      <!-- Contenido principal con margen superior para el header -->
      <div class="mt-16 p-4">
        <slot />
      </div>
    </div>
  </body>
</html>
