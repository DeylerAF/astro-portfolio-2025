---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { PanelLeft, PanelLeftClose } from "lucide-astro";

interface Props {
  title?: string;
}

const { title = "Astro Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Theme initialization script -->
    <script is:inline>
      // Get the user's theme preference from local storage or system
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        // Default to system preference
        return "system";
      };

      const themeValue = getThemePreference();

      // Apply theme immediately to prevent flash
      if (
        themeValue === "dark" ||
        (themeValue === "system" &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.add("light");
      }
    </script>
  </head>
  <body>
    <Sidebar />
    <div
      id="content"
      class="ml-16 w-[calc(100%-4rem)] transition-all duration-300 ease-in-out"
    >
      <div class="fixed top-4 right-4 z-30">
        <ThemeToggle />
      </div>
      <slot />
    </div>
  </body>
</html>
