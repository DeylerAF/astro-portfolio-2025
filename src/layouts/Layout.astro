---
import "../styles/global.css";
import Sidebar from "../components/sidebar/Sidebar.astro";
import Header from "../components/Header.astro";
import { THEME_STORAGE_KEY, THEME_CLASSES } from "../lib/utils/theme";

interface Props {
  title?: string;
}

const { title = "Astro Portfolio" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Minimal theme initialization script to prevent flash -->
    <script is:inline define:vars={{ THEME_STORAGE_KEY, THEME_CLASSES }}>
      // Get theme preference from localStorage
      const theme = localStorage.getItem(THEME_STORAGE_KEY);
      const systemPrefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)"
      ).matches;

      // Remove any existing theme classes
      document.documentElement.classList.remove(
        THEME_CLASSES.light,
        THEME_CLASSES.dark
      );

      // Apply the appropriate theme class
      if (theme === "dark" || (theme !== "light" && systemPrefersDark)) {
        document.documentElement.classList.add(THEME_CLASSES.dark);
      } else {
        document.documentElement.classList.add(THEME_CLASSES.light);
      }
    </script>
  </head>
  <body class="flex">
    <!-- Backdrop overlay for mobile when sidebar is open -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/30 backdrop-blur-sm z-40 hidden md:hidden"
      aria-hidden="true"
    >
    </div>

    <Sidebar />
    <div
      id="content"
      class="md:ml-16 flex-grow transition-all duration-300 ease-in-out"
    >
      <!-- Header component -->
      <Header />
      <!-- Contenido principal con margen superior para el header -->
      <div class="mt-16 p-4">
        <slot />
      </div>
    </div>
  </body>
</html>
