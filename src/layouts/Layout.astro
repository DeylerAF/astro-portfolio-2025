---
import "../styles/global.css";
import Sidebar from "../components/sidebar/Sidebar.astro";
import Header from "../components/Header.astro";
import { generateInitializationScript } from "../lib/utils/theme";
import { getProfileDataAndIntroBlocks } from "../lib/services/notion/notionProfile";

interface Props {
  title?: string;
}

// Fetch Notion profile data for favicon and title
let notionProfileData = null;
let notionTitle = "Astro Portfolio";
let notionAvatarUrl = "/favicon.svg";
try {
  const pageId = import.meta.env.PUBLIC_NOTION_PAGE_ID;
  if (import.meta.env.PUBLIC_NOTION_TOKEN && pageId) {
    const result = await getProfileDataAndIntroBlocks(pageId);
    if (result.profileData) {
      notionProfileData = result.profileData;
      if (notionProfileData.title) notionTitle = notionProfileData.title;
      if (notionProfileData.avatarUrl) notionAvatarUrl = notionProfileData.avatarUrl;
    }
  }
} catch (e) {
  // Fallback to defaults
}

const { title } = Astro.props;
const themeInitScript = generateInitializationScript();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={notionAvatarUrl} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="My personal portfolio built with Astro" />
    <title>{title ?? notionTitle}</title>
    <!-- Theme initialization script with system preference detection -->
    <script is:inline set:html={themeInitScript} />
  </head>
  <body class="flex min-h-screen bg-[var(--body-bg)] text-[var(--text-color)]">
    <!-- Backdrop overlay for mobile when sidebar is open -->
    <div
      id="sidebar-overlay"
      class="fixed inset-0 bg-black/30 backdrop-blur-sm z-30 hidden md:hidden"
      aria-hidden="true"
    >
    </div>

    <Sidebar />
    <div
      id="content"
      class="md:ml-16 flex-grow transition-all duration-300 ease-in-out max-w-full overflow-x-hidden flex flex-col"
    >
      <!-- Header component -->
      <Header />
      <!-- Content container that will receive the page content -->
      <div class="p-4 md:p-6 container mx-auto max-w-6xl">
        <slot />
      </div>
      <!-- Footer -->
      <footer class="mt-auto py-4 text-center text-sm opacity-75">
        &copy; {new Date().getFullYear()} My Portfolio. Built with Astro.
      </footer>
    </div>
  </body>
</html>
