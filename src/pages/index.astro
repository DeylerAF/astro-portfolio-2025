---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Portfolio Home">
  <main class="mx-auto px-6 py-6 max-w-7xl">
    <h1 class="text-4xl font-bold mb-4">Welcome to My Portfolio</h1>
    <p class="text-lg mb-6">
      This is a modern portfolio site built with Astro and Tailwind CSS, using
      Notion as a CMS.
    </p>

    <div class="mt-8">
      <a
        href="/projects"
        class="inline-block bg-[var(--accent-color)] hover:bg-[var(--accent-tertiary)] text-white px-4 py-2 rounded font-medium transition-colors"
      >
        View Projects
      </a>
    </div>
  </main>
</Layout>
