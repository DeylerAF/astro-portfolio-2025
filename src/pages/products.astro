---
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../lib/services/notion/notionProducts";
import { parseNotionProperties } from "../lib/services/notion/notionProperties";
import { getImagesFromPage } from "../lib/services/notion/notionImages";
import type { PageObjectResponse } from "@notionhq/client/build/src/api-endpoints";

// Fetch products from Notion
const notionProducts = await getProducts();

// Define the product type to avoid TypeScript errors
interface Product {
  id: string;
  Name?: string;
  Description?: string;
  Tags?: string[];
  Image?: string[];
  ContentImages?: string[];
  AllImages?: string[];
  URL?: string;
  [key: string]: unknown;
}

// Parse the properties for easier use in the template and fetch additional images
const products = await Promise.all(
  notionProducts.map(async (product) => {
    const pageObject = product as PageObjectResponse;
    const parsedProduct = {
      id: product.id,
      ...parseNotionProperties(pageObject.properties || {}),
    } as Product;
    // Fetch all images from the product page
    const images = await getImagesFromPage(product.id);
    // Add content images and all images to the product
    parsedProduct.ContentImages = images.blockImages;
    parsedProduct.AllImages = images.allImages;
    return parsedProduct;
  })
);
---

<Layout title="Products">
  <main class="mx-auto px-6 py-6 max-w-7xl">
    <h1 class="text-4xl font-bold mb-4 text-[var(--text-color)]">
      My Products
    </h1>
    <p class="text-lg text-[var(--sidebar-text)]">
      These products are pulled directly from my Notion database
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
      {
        products.length === 0 ? (
          <p class="text-[var(--sidebar-text)]">
            No products found. Make sure your Notion credentials are correct and
            your database has content.
          </p>
        ) : (
          products.map((product) => (
            <article class="rounded-lg overflow-hidden bg-[var(--card-bg)] shadow-[0_4px_6px_var(--card-shadow)] hover:shadow-[0_10px_15px_var(--card-shadow)] hover:-translate-y-1 transition-all duration-200">
              {/* Display product image from property or content */}
              {(product.Image && product.Image[0]) ||
              (product.AllImages && product.AllImages[0]) ? (
                <img
                  src={
                    (product.Image && product.Image[0]) ||
                    (product.AllImages && product.AllImages[0])
                  }
                  alt={`Product: ${product.Name}`}
                  class="w-full h-44 object-cover"
                  loading="lazy"
                />
              ) : null}
              <div class="p-6">
                <h2 class="text-2xl font-semibold mb-3 text-[var(--text-color)]">
                  {product.Name}
                </h2>
                {product.Description && (
                  <p class="text-[var(--text-color)] opacity-80">
                    {product.Description}
                  </p>
                )}
                {product.Tags && (
                  <ul class="flex flex-wrap gap-2 my-4">
                    {product.Tags.map((tag: string) => (
                      <li class="bg-[var(--hover-bg)] text-[var(--sidebar-text)] px-2 py-1 rounded text-sm">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}
                {product.URL && (
                  <a
                    href={product.URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block bg-[var(--accent-color)] hover:bg-[var(--accent-tertiary)] text-white px-4 py-2 rounded font-medium mt-4 transition-colors"
                  >
                    View Product
                  </a>
                )}
              </div>
            </article>
          ))
        )
      }
    </div>
  </main>
</Layout>
