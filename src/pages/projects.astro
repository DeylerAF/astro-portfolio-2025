---
import Layout from "../layouts/Layout.astro";
import { getProjects, parseNotionProperties } from "../lib/services/notion";
import type { PageObjectResponse } from "@notionhq/client/build/src/api-endpoints";

// Fetch projects from Notion
const notionProjects = await getProjects();

// Define the project type to avoid TypeScript errors
interface Project {
  id: string;
  Name?: string;
  Description?: string;
  Tags?: string[];
  Image?: string[];
  URL?: string;
  [key: string]: unknown;
}

// Parse the properties for easier use in the template
const projects = notionProjects.map((project) => {
  const pageObject = project as PageObjectResponse;
  return {
    id: project.id,
    ...parseNotionProperties(pageObject.properties || {}),
  } as Project;
});
---

<Layout title="Portfolio Projects">
  <main class="mx-auto px-6 py-6 max-w-7xl">
    <h1 class="text-4xl font-bold mb-4">My Projects</h1>
    <p class="text-lg">
      These projects are pulled directly from my Notion database
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
      {
        projects.length === 0 ? (
          <p class="text-gray-600">
            No projects found. Make sure your Notion credentials are correct and
            your database has content.
          </p>
        ) : (
          projects.map((project) => (
            <article class="rounded-lg overflow-hidden bg-gray-50 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-200">
              {project.Image && project.Image[0] && (
                <img
                  src={project.Image[0]}
                  alt={`Project: ${project.Name}`}
                  class="w-full h-44 object-cover"
                />
              )}
              <div class="p-6">
                <h2 class="text-2xl font-semibold mb-3">{project.Name}</h2>
                {project.Description && (
                  <p class="text-gray-700">{project.Description}</p>
                )}

                {project.Tags && (
                  <ul class="flex flex-wrap gap-2 my-4">
                    {project.Tags.map((tag: string) => (
                      <li class="bg-gray-200 text-gray-700 px-2 py-1 rounded text-sm">
                        {tag}
                      </li>
                    ))}
                  </ul>
                )}

                {project.URL && (
                  <a
                    href={project.URL}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded font-medium mt-4 transition-colors"
                  >
                    View Project
                  </a>
                )}
              </div>
            </article>
          ))
        )
      }
    </div>
  </main>
</Layout>
